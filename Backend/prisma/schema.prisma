generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model pixel {
  PIXEL_INDEX      Int       @id @default(autoincrement())
  PIXEL_POS_X      Int
  PIXEL_POS_Y      Int
  PIXEL_COLOR_R    Int
  PIXEL_COLOR_G    Int
  PIXEL_COLOR_B    Int
  PIXEL_UUID       String    @db.VarChar(36) @default(uuid())
  PIXEL_PAINTED_BY Int
  PIXEL_PAINTED_AT DateTime  @default(now())

  user             user      @relation(fields: [PIXEL_PAINTED_BY], references: [USER_INDEX], onDelete: Cascade)

  @@unique([PIXEL_POS_X, PIXEL_POS_Y], map: "unique_pixel")
  @@index([PIXEL_PAINTED_BY])
}

model canvas_snapshot {
  snapshot_idx      Int       @id @default(autoincrement())
  snapshot_cx       Int
  snapshot_cy       Int
  snapshot_size     Int
  snapshot_version  Int
  snapshot_payload  Bytes     @db.LongBlob
  created_at        DateTime  @default(now())

  version  snapshot_versions @relation(fields: [snapshot_version], references: [version_idx], onDelete: Cascade)

  @@unique([snapshot_version, snapshot_cx, snapshot_cy])
  @@index([snapshot_cx, snapshot_cy])
  @@index([snapshot_version])
}

model canvas_events {
  event_idx         Int       @id @default(autoincrement())
  userId            Int
  event_x           Int
  event_y           Int
  event_payload     Bytes     @db.LongBlob
  created_at        DateTime  @default(now())

  user             user      @relation(fields: [userId], references: [USER_INDEX], onDelete: Cascade)
}

model snapshot_versions {
  version_idx       Int       @id @default(autoincrement())
  created_at        DateTime  @default(now())
  completed         Boolean   @default(false)

  snapshots         canvas_snapshot[]
}

model user {
  USER_INDEX      Int      @id @default(autoincrement())
  USER_DISPLAY    String   @db.VarChar(16)
  USER_EMAIL      String   @unique @db.VarChar(255)
  USER_PASSWORD   String   @db.VarChar(255)
  USER_RESTRICTED Boolean  @default(false)
  USER_PAINTED    Int      @default(0)

  pixels          pixel[]
  canvas_events   canvas_events[]
}