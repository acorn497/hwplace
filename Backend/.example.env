# Server
PORT=3000

# 인증 (필수)
# 지정하지 않으면 코드의 "TEMPORARY_SECRET" 으로 떨어져 토큰을 위조할 수 있다.
JWT_SECRET=CHANGE_ME_BEFORE_DEPLOY

# Database
DATABASE_URL="mysql://root:1234@localhost:3306/hwplace"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=1234

# Canvas Settings
CANVAS_SIZE_X=500
CANVAS_SIZE_Y=500

# Worker Settings
# 코드가 읽는 이름은 WORKER_BATCH_SIZE 다.
# (WORKER_MAX_CONCURRENT / WORKER_MAX_BATCH_SIZE / WORKER_BATCH_TIMEOUT 은 어디서도 읽지 않는다)
WORKER_BATCH_SIZE=500
WORKER_MAX_RETRY=3

# Canvas Chunk (필수 - 없으면 부팅 실패)
CHUNK_SIZE=64

# 스냅샷 주기 (기본: 매시 정각)
SNAPSHOT_CRON=0 * * * *

# Body Size (요청 하나에 담기는 픽셀 수를 입구에서 제한)
BODY_SIZE_LIMIT=4mb

# Paint Quota (유저별 칠하기 속도 제한)
# 기본: 3분(180초)당 5,000 픽셀
PAINT_QUOTA_WINDOW_SECONDS=180
PAINT_QUOTA_PIXELS=5000

# 자동 제재 (쿼터에 막히고도 계속 두드리는 계정)
# 세는 것은 '픽셀 양'이 아니라 '쿼터 초과로 거절당한 요청 횟수'다.
# 아래 기본값 = 300초(5분) 안에 거절이 20회 쌓이면 자동 제재.
# 정상 유저는 한도에 걸리면 회복 시간을 보고 기다리므로 여기까지 가지 않는다.
PAINT_AUTO_RESTRICT=true
PAINT_ABUSE_STRIKES=20
PAINT_ABUSE_WINDOW_SECONDS=300

# IP별 요청 수 제한 (초당 / 분당 / 시간당)
THROTTLE_SHORT=20
THROTTLE_MEDIUM=300
THROTTLE_LONG=5000

# 신규 계정 쿼터 제한 (계정 찍어내기로 쿼터를 우회하는 것을 막는다)
# 가입 후 N시간 동안은 낮은 한도를 적용한다.
PAINT_QUOTA_NEW_ACCOUNT_PIXELS=1000
PAINT_NEW_ACCOUNT_HOURS=24

# IP 단위 픽셀 총량 (계정과 무관한 축)
# 유저 쿼터는 계정을 새로 만들면 초기화되므로, 한 IP의 총량을 따로 묶는다.
# 학교/회사 같은 공유망을 고려해 유저 한도보다 넉넉하게 잡는다.
PAINT_QUOTA_IP_PIXELS=15000

# 앞단에 프록시/LB 가 있으면 true. X-Forwarded-For 를 신뢰할지 결정한다.
# 프록시가 없는데 켜면 헤더를 위조해 IP 한도를 우회할 수 있으니 주의.
TRUST_PROXY=false

# 회원가입 전용 제한 (IP당 시간당 가입 수)
# bcrypt 때문에 가입 1건이 1.7초쯤 걸려 위의 초/분 단위 창에는 걸리지 않는다.
THROTTLE_REGISTER=5

# 샌드박스 캔버스 (봇/스크립트용 무제한 구역)
# 메인 캔버스 오른쪽에 붙는 별도 공간. 주기적으로 초기화되며 리플레이 이력을 남기지 않는다.
# (이력을 남기면 무제한 칠하기가 곧 무제한 디스크 증가가 된다)
SANDBOX_SIZE_X=512
SANDBOX_SIZE_Y=512
SANDBOX_RESET_MINUTES=60
SANDBOX_RESET_CRON=0 * * * *
SANDBOX_MAX_PIXELS_PER_REQUEST=50000
# 메인 캔버스와 샌드박스 사이 빈 간격(px). 두 구역이 붙어 보이지 않게 한다.
SANDBOX_GAP=64
